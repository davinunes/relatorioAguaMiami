      "parameters": {
        "jsCode": "function formatWahaChatId(chatId) {\n  if (!chatId) return chatId;\n  const match = chatId.match(/^(\\d+)(@s\\.whatsapp\\.net)?$/);\n  if (!match) return chatId;\n  let number = match[1];\n  const domain = match[2] || '@s.whatsapp.net';\n  if (number.startsWith('55') && number.length === 13) {\n    if (number.charAt(4) === '9') {\n      number = number.slice(0, 4) + number.slice(5);\n    }\n  }\n  return number + domain;\n}\n\nconst result = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  const contatos = data.contatos || [];\n  for (const contato of contatos) {\n    result.push({\n      json: {\n        sensor_id: data.sensor_id,\n        nome_sensor: data.nome_sensor,\n        periodo_consultado: data.periodo_consultado,\n        total_itens_encontrados: data.total_itens_encontrados,\n        alerta: data.alerta,\n        diagnostico: data.diagnostico,\n        chart_image_url: data.chart_image_url,\n        chat_id: formatWahaChatId(contato)\n      }\n    });\n  }\n}\nreturn result;"
      },
